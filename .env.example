# LOCAL DEVELOPMENT ONLY. Generate unique values with scripts/setup-local.ps1.
# Empty placeholders intentionally fail Compose until configured. Never reuse for production.
POSTGRES_PASSWORD=
DATABASE_PASSWORD=
MIGRATION_PASSWORD=
BRIDGEOPS_PORT=8088

# Optional invitations: external authenticated SMTP, TLS required. Never commit actual values.
INVITATION_SMTP_ENABLED=false
INVITATION_SMTP_HOST=
INVITATION_SMTP_PORT=587
INVITATION_SMTP_USERNAME=
INVITATION_SMTP_PASSWORD=
INVITATION_SMTP_FROM=
INVITATION_SMTP_SSL=false
